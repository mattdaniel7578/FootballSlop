# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Google OAuth credentials (from https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must be: http://localhost:5000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SQLite file location (relative to project root).
DATABASE_URL=sqlite:///pool.db

# From https://the-odds-api.com/ (free tier available). Games, DraftKings
# spreads, and final results are all pulled automatically on a schedule —
# without this, no games will appear.
ODDS_API_KEY=

# How often to re-pull DraftKings spreads/results, in minutes.
ODDS_SYNC_MINUTES=60

# The Tuesday that Week 1 of the season starts on (NFL weeks run Tue-Mon).
# Anchors week numbering for synced games; without it every game defaults
# to week 1.
SEASON_START_DATE=2026-09-08
