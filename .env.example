# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Google OAuth credentials (from https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must be: http://localhost:5000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of emails allowed to add/edit games and spreads.
ADMIN_EMAILS=you@example.com

# SQLite file location (relative to project root).
DATABASE_URL=sqlite:///pool.db
